# ─────────────────────────────────────────────
#  Card Sorter Bot — Dockerfile
#  Works on: Replit Reserved VM, Railway, Fly.io, any Docker host
# ─────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Install dependencies first (layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy bot code
COPY bot/card_sorter.py bot/

# Health check — Replit and most platforms probe GET /
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT:-8080}/')" || exit 1

ENV PORT=8080

CMD ["python3", "bot/card_sorter.py"]
