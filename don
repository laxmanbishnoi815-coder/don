async def _send_separate_file(message, kind: str, value: str) -> None:
    db = _load_db()
    if kind == "bin":
        cards   = _cards_by_bin(db, value[:6])
        label   = f"BIN_{value[:6]}"
        heading = f"BIN <code>{_esc(value[:6])}</code>"
    elif kind == "bank":
        cards   = _cards_by_bank(db, value)
        label   = re.sub(r"[^\w]", "_", value)[:30]
        heading = f"Bank <b>{_esc(value)}</b>"
    else:
        await message.reply_text("❌ Use <code>bin</code> or <code>bank</code>.",
                                 parse_mode=ParseMode.HTML)
        return

    if not cards:
        await message.reply_text(
            f"❌ No cards found for {heading}.", parse_mode=ParseMode.HTML)
        return

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    fn = f"{label}_{len(cards)}cards_{ts}.txt"
    await message.reply_document(
        document=InputFile(_make_file_bytes(cards), fn),
        caption=(
            f"📁 <b>Separated File</b>\n"
            f"━━━━━━━━━━━━━━━━━━━\n"
            f"Filter : {heading}\n"
            f"Cards  : <b>{len(cards)}</b>\n"
            f"File   : <code>{_esc(fn)}</code>"
        ),
        parse_mode=ParseMode.HTML,
    )


