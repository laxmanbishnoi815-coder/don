def _esc(t: str) -> str:
    return str(t).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _make_file_bytes(cards: list) -> bytes:
    return "\n".join(cards).encode("utf-8")


def _cards_by_bin(db: dict, bin6: str) -> list:
    return [n for n, v in db["cards"].items() if v["bin"] == bin6]


def _cards_by_bank(db: dict, bank_name: str) -> list:
    bn = bank_name.lower()
    return [n for n, v in db["cards"].items() if bn in v["bank"].lower()]


def _is_owner(uid: int) -> bool:
    return OWNER_ID is None or uid == OWNER_ID


def _bin_stats(db: dict) -> Counter:
    return Counter(v["bin"] for v in db["cards"].values())


def _bank_stats(db: dict) -> Counter:
    return Counter(v["bank"] for v in db["cards"].values())


