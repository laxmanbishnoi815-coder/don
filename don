# /stats
# ──────────────────────────────────────────────────────────
async def cmd_stats(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    db    = _load_db()
    total = len(db["cards"])
    if total == 0:
        await update.message.reply_text("📊 Database is empty. Send some cards first!")
        return

    bin_c  = _bin_stats(db)
    bank_c = _bank_stats(db)

    async with aiohttp.ClientSession() as session:
        bin_lines = []
        for b6, cnt in bin_c.most_common(10):
            info = await lookup_bin(b6, session)
            bin_lines.append(
                f"  <code>{b6}</code> ×<b>{cnt}</b>  "
                f"{_esc(info.get('scheme','?'))} — {_esc(info.get('bank','?'))}"
            )

    bank_lines = [
        f"  <b>{_esc(b)}</b> × {c}"
        for b, c in bank_c.most_common(10)
    ]
    text = (
        f"📊 <b>Database Stats</b>\n"
        f"━━━━━━━━━━━━━━━━━━━\n"
        f"💾 Total cards : <b>{total}</b>\n"
        f"🔢 Unique BINs : <b>{len(bin_c)}</b>\n"
        f"🏦 Unique banks: <b>{len(bank_c)}</b>\n\n"
        f"<b>🔝 Top BINs:</b>\n" + "\n".join(bin_lines) +
        "\n\n<b>🔝 Top Banks:</b>\n" + "\n".join(bank_lines)
    )
    await update.message.reply_text(text, parse_mode=ParseMode.HTML)


