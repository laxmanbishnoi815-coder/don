# BUILD PTB APPLICATION
# ──────────────────────────────────────────────────────────
def _build_app() -> Application:
    app = Application.builder().token(BOT_TOKEN).updater(None).build()

    app.add_handler(CommandHandler("start",    cmd_start))
    app.add_handler(CommandHandler("help",     cmd_help))
    app.add_handler(CommandHandler("bin",      cmd_bin))
    app.add_handler(CommandHandler("bank",     cmd_bank))
    app.add_handler(CommandHandler("stats",    cmd_stats))
    app.add_handler(CommandHandler("separate", cmd_separate))
    app.add_handler(CommandHandler("clear",    cmd_clear))
    app.add_handler(CallbackQueryHandler(handle_callback))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_cards_text))
    app.add_handler(MessageHandler(filters.Document.ALL, handle_document))

    return app


# ──────────────────────────────────────────────────────────
# WEBHOOK SERVER  (production mode)
# ──────────────────────────────────────────────────────────
async def _run_webhook(ptb_app: Application) -> None:
    """Start aiohttp server, register Telegram webhook, serve updates."""
    webhook_path = f"/webhook/{BOT_TOKEN}"
    webhook_full = WEBHOOK_URL.rstrip("/") + webhook_path

    await ptb_app.initialize()
    await ptb_app.start()
    await ptb_app.bot.set_webhook(
        url=webhook_full,
        allowed_updates=Update.ALL_TYPES,
        drop_pending_updates=True,
    )
    log.info("Webhook registered: %s", webhook_full)

    aio_app = web.Application()

    async def health(_req: web.Request) -> web.Response:
        return web.json_response({"status": "ok"})

    async def webhook_handler(req: web.Request) -> web.Response:
        try:
            data   = await req.json()
            update = Update.de_json(data, ptb_app.bot)
            await ptb_app.process_update(update)
        except Exception as e:
            log.error("Webhook handler error: %s", e)
        return web.Response(status=200)

    aio_app.router.add_get("/",             health)
    aio_app.router.add_get("/healthz",      health)
    aio_app.router.add_post(webhook_path,   webhook_handler)

    runner = web.AppRunner(aio_app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", PORT)
    await site.start()
    log.info("Listening on 0.0.0.0:%d (webhook mode)", PORT)

    try:
        await asyncio.Event().wait()       # run forever
    finally:
        await ptb_app.bot.delete_webhook()
        await ptb_app.stop()
        await ptb_app.shutdown()
        await runner.cleanup()


# ──────────────────────────────────────────────────────────
# POLLING SERVER  (development mode — no WEBHOOK_URL)
# ──────────────────────────────────────────────────────────
async def _run_polling_with_health(ptb_app: Application) -> None:
    """Run long-polling + a tiny health server on PORT so Replit preview works."""
    aio_app = web.Application()

    async def health(_req: web.Request) -> web.Response:
        return web.json_response({"status": "ok", "mode": "polling"})

    aio_app.router.add_get("/",        health)
    aio_app.router.add_get("/healthz", health)

    runner = web.AppRunner(aio_app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", PORT)
    await site.start()
    log.info("Health server on 0.0.0.0:%d (polling mode)", PORT)

    await ptb_app.initialize()
    await ptb_app.updater.start_polling(
        allowed_updates=Update.ALL_TYPES,
        drop_pending_updates=True,
    )
    await ptb_app.start()
    log.info("Bot polling started")

    try:
        await asyncio.Event().wait()
    finally:
        await ptb_app.updater.stop()
        await ptb_app.stop()
        await ptb_app.shutdown()
        await runner.cleanup()


# ──────────────────────────────────────────────────────────
# ENTRY POINT
# ──────────────────────────────────────────────────────────
def main() -> None:
    global _BIN_CACHE
    _BIN_CACHE = _load_bin_cache()
    log.info("BIN cache: %d entries", len(_BIN_CACHE))

    # Application.builder().updater(None) disables the built-in updater so we
    # control the event loop ourselves — needed for both webhook and our custom
    # polling wrapper.
    ptb_app = _build_app()

    if WEBHOOK_URL:
        log.info("Starting in WEBHOOK mode → %s", WEBHOOK_URL)
        asyncio.run(_run_webhook(ptb_app))
    else:
        log.info("WEBHOOK_URL not set — starting in POLLING mode")
        # Recreate with default updater for polling
        ptb_app2 = Application.builder().token(BOT_TOKEN).build()
        # re-register handlers
        ptb_app2.add_handler(CommandHandler("start",    cmd_start))
        ptb_app2.add_handler(CommandHandler("help",     cmd_help))
        ptb_app2.add_handler(CommandHandler("bin",      cmd_bin))
        ptb_app2.add_handler(CommandHandler("bank",     cmd_bank))
        ptb_app2.add_handler(CommandHandler("stats",    cmd_stats))
        ptb_app2.add_handler(CommandHandler("separate", cmd_separate))
        ptb_app2.add_handler(CommandHandler("clear",    cmd_clear))
        ptb_app2.add_handler(CallbackQueryHandler(handle_callback))
        ptb_app2.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_cards_text))
        ptb_app2.add_handler(MessageHandler(filters.Document.ALL, handle_document))
        asyncio.run(_run_polling_with_health(ptb_app2))


if __name__ == "__main__":
    main()
