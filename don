# ──────────────────────────────────────────────────────────
# CARD EXTRACTION
# ──────────────────────────────────────────────────────────
_CARD_RE = re.compile(
    r"(?<!\d)"
    r"(\d{13,19})"
    r"(?:[\s|/,;:-]+\d{1,2}[\s|/,;:-]+\d{2,4}(?:[\s|/,;:-]+\d{3,4})?)?"
    r"(?!\d)"
)


def luhn_check(number: str) -> bool:
    try:
        digits = [int(d) for d in number]
    except ValueError:
        return False
    digits.reverse()
    total = 0
    for i, d in enumerate(digits):
        if i % 2 == 1:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return total % 10 == 0


def extract_card_numbers(text: str) -> list:
    seen, seen_set = [], set()
    for m in _CARD_RE.finditer(text):
        num = m.group(1)
        if num not in seen_set and luhn_check(num):
            seen_set.add(num)
            seen.append(num)
    return seen


# ──────────────────────────────────────────────────────────
# BIN LOOKUP
# ──────────────────────────────────────────────────────────
async def lookup_bin(bin6: str, session: aiohttp.ClientSession) -> dict:
    global _BIN_CACHE
    if bin6 in _BIN_CACHE:
        return _BIN_CACHE[bin6]
    info = {"bank": "Unknown", "scheme": "Unknown",
            "country": "Unknown", "type": "Unknown"}
    try:
        url = f"https://lookup.binlist.net/{bin6}"
        headers = {"Accept-Version": "3", "User-Agent": "CardSorterBot/1.0"}
        async with session.get(url, headers=headers,
                               timeout=aiohttp.ClientTimeout(total=6)) as r:
            if r.status == 200:
                data = await r.json(content_type=None)
                info["bank"]    = (data.get("bank") or {}).get("name") or "Unknown"
                info["scheme"]  = (data.get("scheme") or "Unknown").upper()
                info["country"] = (data.get("country") or {}).get("name") or "Unknown"
                info["type"]    = (data.get("type") or "Unknown").upper()
    except Exception as e:
        log.debug("BIN lookup %s: %s", bin6, e)
    _BIN_CACHE[bin6] = info
    _save_bin_cache()
    return info


