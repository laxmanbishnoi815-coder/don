        f"🏦 <b>Bank:</b> <code>{_esc(bank_name)}</code>\n"
        f"━━━━━━━━━━━━━━━━━━━\n"
        f"📂 Total matching: <b>{len(cards)}</b>\n\n"
        f"<b>Matched banks:</b>\n{match_lines}"
