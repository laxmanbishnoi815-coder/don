            InlineKeyboardButton(
                f"📁 Separate to File ({len(cards)} cards)",
                callback_data=f"sep:bank:{safe}",
            )
        ]])
    await update.message.reply_text(text, parse_mode=ParseMode.HTML, reply_markup=kb)


