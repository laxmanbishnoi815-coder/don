# ──────────────────────────────────────────────────────────
# CARD TEXT / FILE HANDLER
# ──────────────────────────────────────────────────────────
async def _process_cards_text(update, text: str) -> None:
    cards = extract_card_numbers(text)
    if not cards:
        await update.message.reply_text(
            "❌ No valid card numbers found.\n"
            "Format: <code>4111111111111111|12|26|123</code> or plain card number.",
            parse_mode=ParseMode.HTML,
        )
        return

    progress = await update.message.reply_text(
        f"🔍 Found <b>{len(cards)}</b> card(s). Looking up BINs…",
        parse_mode=ParseMode.HTML,
    )

    db = _load_db()
    new_count = dup_count = 0
    bin_info_map: dict = {}

    async with aiohttp.ClientSession() as session:
        sem = asyncio.Semaphore(3)

        async def _throttled(b6):
            async with sem:
                await asyncio.sleep(0.35)
                return b6, await lookup_bin(b6, session)

        for b6, info in await asyncio.gather(
            *[_throttled(c[:6]) for c in {c[:6] for c in cards}]
        ):
            bin_info_map[b6] = info

    for num in cards:
        if num in db["cards"]:
            dup_count += 1
        else:
            b6   = num[:6]
            info = bin_info_map.get(b6, {})
            db["cards"][num] = {
                "bin":     b6,
                "bank":    info.get("bank",    "Unknown"),
                "scheme":  info.get("scheme",  "Unknown"),
                "country": info.get("country", "Unknown"),
                "type":    info.get("type",    "Unknown"),
                "added":   datetime.now(timezone.utc).isoformat(timespec="seconds"),
            }
            new_count += 1

    _save_db(db)

    # BIN breakdown (capped at 20 lines)
    bin_counts: dict = defaultdict(int)
    for num in cards:
        bin_counts[num[:6]] += 1

    lines = []
    for b6, cnt in sorted(bin_counts.items(), key=lambda x: -x[1])[:20]:
        info = bin_info_map.get(b6, {})
        lines.append(
            f"  <code>{b6}</code> ×{cnt}  "
            f"{_esc(info.get('scheme','?'))} — {_esc(info.get('bank','?'))} — {_esc(info.get('country','?'))}"
        )
    if len(bin_counts) > 20:
        lines.append(f"  … and {len(bin_counts)-20} more BINs")

    caption = (
        f"✅ <b>Done!</b>\n"
        f"━━━━━━━━━━━━━━━━━━━\n"
        f"📦 Found   : <b>{len(cards)}</b>\n"
        f"🆕 New     : <b>{new_count}</b>\n"
        f"♻️  Dupes   : <b>{dup_count}</b>\n"
        f"💾 DB total: <b>{len(db['cards'])}</b>\n\n"
        f"<b>BIN breakdown:</b>\n" + "\n".join(lines)
    )

    ts  = datetime.now().strftime("%Y%m%d_%H%M%S")
    fn  = f"cards_{ts}_{len(cards)}.txt"
    try:
        await progress.delete()
    except Exception:
        pass
    await update.message.reply_document(
        document=InputFile(_make_file_bytes(cards), fn),
        caption=caption,
        parse_mode=ParseMode.HTML,
    )


async def handle_cards_text(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    await _process_cards_text(update, update.message.text or "")


async def handle_document(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    doc = update.message.document
    if not doc:
        return
    if doc.file_size and doc.file_size > 5 * 1024 * 1024:
        await update.message.reply_text("❌ File too large (max 5 MB).")
        return
    progress = await update.message.reply_text("📥 Reading file…")
    try:
        file      = await doc.get_file()
        raw_bytes = await file.download_as_bytearray()
        text      = raw_bytes.decode("utf-8", errors="ignore")
    except Exception as e:
        await progress.edit_text(f"❌ Could not read file: {e}")
        return
    await progress.delete()
    await _process_cards_text(update, text)


